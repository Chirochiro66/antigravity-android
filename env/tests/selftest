#!/usr/bin/env bash
# selftest -- offline checks for pkg core (no network).
set -uo pipefail

SELF="$(cd "$(dirname "$0")" && pwd)"
PKG_DIR="$SELF/../pkg"
PKG_LIB="$PKG_DIR/lib"
PKG_SELF="$PKG_DIR"

PREFIX="$(mktemp -d)/usr"
export PREFIX

. "$PKG_LIB/util.sh"
. "$PKG_LIB/version.sh"
. "$PKG_LIB/index.sh"
. "$PKG_LIB/db.sh"
. "$PKG_LIB/deb.sh"
. "$PKG_LIB/resolver.sh"
. "$PKG_LIB/remove.sh"
# rewrite.sh is sourced by util.sh; nothing to do here.
ensure_dirs

fail=0
ok()   { printf 'PASS  %s\n' "$1"; }
bad()  { printf 'FAIL  %s\n' "$1"; fail=$((fail + 1)); }

# ---- version comparison ----------------------------------------------------
vc() { # A B EXPECTED
    local got; got="$(deb_vercmp "$1" "$2")"
    [ "$got" = "$3" ] && ok "vercmp $1 $2 = $3" || bad "vercmp $1 $2 = $3 (got $got)"
}
vc 1.0.0       1.0.0       0
vc 1.0.0       1.0.1      -1
vc 1.0.1       1.0.0       1
vc 2.0         10.0       -1
vc 1.0~rc1     1.0        -1
vc 1:1.0       2.0         1
vc 1.0-1       1.0-2      -1
vc 1.0         1.0-0       0
vc 1.0-1       1.0-1       0
vc 1.2.3-4     1.2.3-4build1 -1
vc 1.0a        1.0b       -1
vc 1.0+really1.1 1.0       1

# ---- index parsing ---------------------------------------------------------
FIX="$SELF/fixtures/Packages"
[ "$(index_get "$FIX" hello 2)"    = "1.0.0" ]   && ok "index version"    || bad "index version"
[ "$(index_get "$FIX" hello 5)"    = "libhello (>= 1.0), world | glob" ] && ok "index depends" || bad "index depends"
[ "$(index_get "$FIX" world 4)"    = "yes" ]     && ok "index essential"  || bad "index essential"
[ "$(index_get "$FIX" world 7)"    = "glob" ]    && ok "index provides"   || bad "index provides"

# continuation line must not become a field
[ "$(index_get "$FIX" hello 1)"    = "hello" ]   && ok "index name"       || bad "index name"

# ---- db --------------------------------------------------------------------
printf 'bin/hello\nlib/libhello.so\n' | db_put hello 1.0.0 aarch64
[ "$(db_get hello version)" = "1.0.0" ] && ok "db get" || bad "db get"
db_exists hello && ok "db exists" || bad "db exists"
[ "$(db_owner bin/hello)" = "hello" ] && ok "db owner" || bad "db owner"
db_list | grep -q '^hello 1.0.0$' && ok "db list" || bad "db list"
db_remove hello
db_exists hello && bad "db remove" || ok "db remove"

# ---- version constraints ---------------------------------------------------
vs() { # V OP WANT EXPECT(0 ok,1 not)
    if ver_satisfies "$1" "$2" "$3"; then s=0; else s=1; fi
    [ "$s" = "$4" ] && ok "satisfies $1 $2 $3 = $4" || bad "satisfies $1 $2 $3 = $4 (got $s)"
}
vs 1.2.0 ">=" 1.0.0 0
vs 0.9   ">=" 1.0.0 1
vs 1.0   "="  1.0   0
vs 1.0   ">>" 1.0   1
vs 1:2.0 ">=" 2.0   0

# ---- dependency closure -----------------------------------------------------
cp "$FIX" "$PKG_INDEX/repo.1.Packages"
index_rebuild_all
resolved="$(resolve hello 2>/dev/null)"
[ "$resolved" = $'libhello\nworld\nhello' ] \
    && ok "dependency order + alternatives" || bad "dependency order + alternatives ($resolved)"
provided="$(resolve glob 2>/dev/null)"
[ "$provided" = "world" ] && ok "direct virtual provider" || bad "direct virtual provider ($provided)"
if resolve missing-package >/dev/null 2>&1; then
    bad "unresolved dependency rejected"
else
    ok "unresolved package rejected"
fi

# ---- .deb (ar + tar) -------------------------------------------------------
DEB="$SELF/fixtures/hello.deb"
if [ -f "$DEB" ]; then
    [ "$(ar_members "$DEB" | tr '\n' ' ')" = "debian-binary control.tar.xz data.tar.xz " ] \
        && ok "deb ar members" || bad "deb ar members"
    [ "$(deb_field "$DEB" Version)" = "2.12.3-1" ] && ok "deb control Version" || bad "deb control Version"
    [ "$(deb_field "$DEB" Depends)" = "libiconv" ] && ok "deb control Depends" || bad "deb control Depends"
    deb_files "$DEB" | grep -qx 'bin/hello' && ok "deb data files" || bad "deb data files"
else
    printf 'SKIP  deb checks (no fixtures/hello.deb)\n'
fi

# ---- dynamic notification bridge -------------------------------------------
NOTIFY_TMP="$(mktemp -d)"
mkdir -p "$NOTIFY_TMP/bin"
cat > "$NOTIFY_TMP/bin/rish" <<'EOF'
#!/bin/sh
printf '%s\n' "$*" >> "$AGY_NOTIFY_CAPTURE"
EOF
chmod +x "$NOTIFY_TMP/bin/rish"
export AGY_NOTIFY_CAPTURE="$NOTIFY_TMP/calls.log"
if PREFIX="$NOTIFY_TMP" bash "$SELF/../overlay/bin/agy-notify" cancel task_123 \
        && grep -Fq 'cmd notification cancel task_123' "$AGY_NOTIFY_CAPTURE"; then
    ok "agy-notify cancel forwards its positional tag"
else
    bad "agy-notify cancel forwards its positional tag"
fi
if PREFIX="$NOTIFY_TMP" bash "$SELF/../overlay/bin/agy-notify" cancel >/dev/null 2>&1; then
    bad "agy-notify rejects missing cancel tag"
else
    ok "agy-notify rejects missing cancel tag"
fi
# Post should also reach rish with the expected command, title and body.
> "$AGY_NOTIFY_CAPTURE"
# agy-notify shells out via rish and the arguments go through printf %q, so
# spaces show up as backslash-escaped. Match the literal shell-quoted form.
if PREFIX="$NOTIFY_TMP" bash "$SELF/../overlay/bin/agy-notify" post \
        -t "Build done" -m "tests passed" --tag build_42 \
        && grep -Fq 'cmd notification post' "$AGY_NOTIFY_CAPTURE" \
        && grep -Fq 'Build\ done' "$AGY_NOTIFY_CAPTURE" \
        && grep -Fq 'tests\ passed' "$AGY_NOTIFY_CAPTURE" \
        && grep -Fq 'build_42' "$AGY_NOTIFY_CAPTURE"; then
    ok "agy-notify post forwards title/body/tag to rish"
else
    bad "agy-notify post forwards title/body/tag to rish"
fi
rm -rf "$NOTIFY_TMP"
unset AGY_NOTIFY_CAPTURE

# ---- atomic path rewrite ---------------------------------------------------
# Use a temporary prefix tree with a sample file that contains a legacy
# foreign prefix. rewrite_paths must repoint it to $PREFIX in place; a
# second call must be a no-op and report zero rewrites.
REWRITE_TMP="$(mktemp -d)/usr"
mkdir -p "$REWRITE_TMP/bin"
cat > "$REWRITE_TMP/bin/sample.sh" <<EOF
#!/data/data/com.termux/files/usr/bin/bash
echo "use /data/data/com.termux/files/usr/share/..."
EOF
chmod +x "$REWRITE_TMP/bin/sample.sh"
PREFIX="$REWRITE_TMP" bash -c '
    . "$1/pkg/lib/rewrite.sh" >/dev/null
    REWRITE_QUIET=1 rewrite_paths
    [ "${REWRITE_COUNT:-0}" -eq 1 ] || { echo "first pass count=${REWRITE_COUNT:-0}"; exit 1; }
    REWRITE_QUIET=1 rewrite_paths
    [ "${REWRITE_COUNT:-0}" -eq 0 ] || { echo "second pass count=${REWRITE_COUNT:-0}"; exit 1; }
' _ "$(cd -- "$SELF/.." && pwd)" \
    && ok "rewrite_paths: rewrites once, idempotent" \
    || bad "rewrite_paths: rewrites once, idempotent"
# The original shebang should now be repointed to PREFIX.
if head -1 "$REWRITE_TMP/bin/sample.sh" | grep -qF "$REWRITE_TMP"; then
    ok "rewrite_paths: shebang repointed to PREFIX"
else
    bad "rewrite_paths: shebang repointed to PREFIX"
fi
rm -rf "$(dirname -- "$REWRITE_TMP")"

# ---- transactional install -------------------------------------------------
# Manually run install_one with a known-good .deb and a non-existent entry
# in the index. The "package" should be extracted into a staging tree but
# never reach $PREFIX. We exercise this by giving a cache file that does
# not match any index entry; install_one must die() before extraction.
TRANS_TMP="$(mktemp -d)/usr"
mkdir -p "$TRANS_TMP"
DEB="$SELF/fixtures/hello.deb"
if [ -f "$DEB" ]; then
    # Use the same prefix the test set up so the staging tree lives under
    # $PKG_ROOT/staging; an aborted install_one must clean it up.
    if PREFIX="$TRANS_TMP" PKG_LIB="$(cd -- "$SELF/../pkg/lib" && pwd)" bash -c '
        set -uo pipefail
        . "$PKG_LIB/util.sh"
        . "$PKG_LIB/version.sh"
        . "$PKG_LIB/index.sh"
        . "$PKG_LIB/db.sh"
        . "$PKG_LIB/deb.sh"
        ensure_dirs
        # Hand install_one a path that index_lookup will reject; we expect
        # an exit 1 with "unknown package: <name>".
        if install_one "definitely-not-a-real-package" 2>/dev/null; then
            echo "BUG: install_one accepted unknown package"; exit 1
        fi
        # The staging tree should be empty (mkdir -p is the only side effect,
        # no .rewrt.$$ tmpfiles leaked).
        if [ -n "$(find "$PKG_ROOT/staging" -mindepth 1 -maxdepth 1 2>/dev/null)" ]; then
            echo "BUG: staging tree has leftovers: $(ls -A "$PKG_ROOT/staging")"
            exit 1
        fi
    ' 2>/dev/null; then
        ok "install_one: fails closed on unknown package, no staging leak"
    else
        bad "install_one: fails closed on unknown package, no staging leak"
    fi
else
    printf 'SKIP  transactional install (no fixtures/hello.deb)\n'
fi
rm -rf "$(dirname -- "$TRANS_TMP")"

# ---- safe remove ------------------------------------------------------------
# Two packages own files in the same parent directory. Removing one must
# not rmdir the parent if the other still has a file in it.
SAFE_TMP="$(mktemp -d)/usr"
mkdir -p "$SAFE_TMP/bin/shared"
echo "pkg-A" > "$SAFE_TMP/bin/shared/a.sh"
echo "pkg-B" > "$SAFE_TMP/bin/shared/b.sh"
chmod +x "$SAFE_TMP/bin/shared/a.sh" "$SAFE_TMP/bin/shared/b.sh"
PREFIX="$SAFE_TMP" PKG_LIB="$(cd -- "$SELF/../pkg/lib" && pwd)" bash -c '
    set -uo pipefail
    . "$PKG_LIB/util.sh"
    . "$PKG_LIB/version.sh"
    . "$PKG_LIB/index.sh"
    . "$PKG_LIB/db.sh"
    . "$PKG_LIB/deb.sh"
    . "$PKG_LIB/resolver.sh"
    . "$PKG_LIB/remove.sh"
    ensure_dirs
    printf "bin/shared/a.sh\n" | db_put pkg-A 1.0 aarch64
    printf "bin/shared/b.sh\n" | db_put pkg-B 1.0 aarch64
    cmd_remove pkg-A >/dev/null
' 2>/dev/null
# pkg-B should still be intact; bin/shared must still exist.
if [ -f "$SAFE_TMP/bin/shared/b.sh" ] && [ ! -f "$SAFE_TMP/bin/shared/a.sh" ] \
        && [ -d "$SAFE_TMP/bin/shared" ]; then
    ok "cmd_remove: keeps sibling package files and shared dir"
else
    bad "cmd_remove: keeps sibling package files and shared dir"
fi
rm -rf "$(dirname -- "$SAFE_TMP")"

rm -rf "$(dirname "$PREFIX")"
printf '== failures: %s ==\n' "$fail"
[ "$fail" = 0 ]
